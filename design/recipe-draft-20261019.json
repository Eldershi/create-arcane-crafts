  "constraints": [
    "升华室和补给升级的材料合成修改仍是审核草案；升华模板已应用用户指定的金板、紫水晶、铜板与烈焰人升级锻造模板九宫格配方。",
    "卷轴打印、逐级升华与余烬蛋糕已按用户明确要求采用原生Create序列组装，loops=1。",
    "不改既定升级费用、猩红四倍升华效率、Max+3、每级超越蛋糕与墨水用量。",
    "墨水复用5种原生流体和瓶，不新增墨水桶。"
  ],
  "review_notes": [
    "灰烬源质是原生远古骑士掉落，继续作为超越的探索门槛。",
    "升华室内1红=4蓝换液保留；普通搅拌配方不提供直接的4蓝→1红逆向浓缩，猩红生产线用血强化。",
    "两种原液依照用户设定可在足量大液池中由机械动力无限抽取；超越仍要灰烬蛋糕和传说墨水。",
    "猩红生产用血强化、1红=4蓝的约定保留；因此加血路线也能得到更多蓝液等效量，属于已批准转换的结果。",
    "满级10的三级超越直接扣937.5mB红液，另3蛋糕预制共3000mB红液；合计3937.5mB红液、3灰烬源质、3鸡蛋、3糖及3瓶传说墨水。"
  ],
  "safeguards": [
    {
      "status": "implemented",
      "id": "no_printed_scroll_ink_recycling",
      "rule": "打印出的卷轴保留来源标记，禁止通过炼金锅回收墨水；涉及其他卷轴变换时也要核对来源标记。",
      "reason": "原生炼金锅有50%卷轴回收概率；若复制只用纸和少量原液，可绕过整条墨水浓缩链。"
    },
    {
      "status": "retain_implemented",
      "id": "no_overcap_printing",
      "rule": "超过该法术原生等级上限的卷轴不能作为打印样板。"
    }
  ],
